# ==========================================
# ОБРАЗОВАТЕЛЬНЫЙ ПОРТАЛ ТЕХНИКУМА (РЕСПУБЛИКА УЗБЕКИСТАН)
# White-Label College CMS (SPO Portal)
# Пример переменных окружения (.env.example)
# ==========================================

# --- SUPABASE CONFIGURATION ---
# Публичный URL проекта Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Публичный Anon/Public API ключ (для клиентской авторизации на фронтенде)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# Сервисный ключ Supabase Service Role (строго для бэкенда NestJS, никогда не передавать на клиент)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key

# JWT Secret из настроек Supabase Auth (для верификации JWT токенов в NestJS Guards)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Прямое подключение к PostgreSQL Supabase (для миграций и сидов)
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project-id.supabase.co:5432/postgres

# --- APPS/API CONFIGURATION (NestJS) ---
PORT=4000
API_PREFIX=api/v1
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
# Redis кэш и защита от Thundering Herd (Single-Flight). Оставьте пустым для быстрого in-memory fallback
REDIS_URL=redis://localhost:6379

# --- APPS/WEB CONFIGURATION (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- WHITE-LABEL SETUP WIZARD (Первичная настройка системы) ---
# Одноразовый секретный мастер-токен для завершения настройки (POST /setup/complete).
# Команда для генерации:
#   openssl rand -hex 32
#   или
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SETUP_TOKEN=your_long_random_setup_token_here_minimum_32_characters

